    <bpmn:userTask id="Activity_14ct1dk" name="Anfrage klassifizieren" camunda:candidateGroups="service-mitarbeiter">
      <bpmn:documentation>Der Service-Mitarbeiter ordnet die vollständige Anfrage einer Anliegenart zu. Davon hängt ab, welche Fachabteilung die Anfrage bearbeitet (Fachliche Rückfrage, Datenfehler, Technisches Problem oder Änderungswunsch). Beim Abschluss dieses Schritts durchsucht ein JavaScript-Task automatisiert die GitHub-Issue-Datenbank nach bereits bekannten, vergleichbaren Fehlern.</bpmn:documentation><bpmn:extensionElements><camunda:formData><camunda:formField id="kundennummer" label="Kundennummer" type="string"/><camunda:formField id="beschreibung" label="Beschreibung des Anliegens" type="string"/><camunda:formField id="anliegenart" label="Anliegenart" type="enum"><camunda:value id="fachlich" name="Fachlich"/><camunda:value id="datenfehler" name="Datenfehler"/><camunda:value id="technisches_problem" name="Technisches Problem"/><camunda:value id="aenderungswunsch" name="Änderungswunsch"/></camunda:formField></camunda:formData><camunda:executionListener event="end"><camunda:script scriptFormat="javascript">// JavaScript-Task (ExecutionListener "end"): GitHub-Issue-Suche nach bekannten,
// vergleichbaren Fehlern fuer "Datenfehler" / "Technisches Problem".
var anliegenart = execution.getVariable('anliegenart');
var anzahl = 0;
var url = '';

if (anliegenart === 'datenfehler' || anliegenart === 'technisches_problem') {
  try {
    var HttpClient   = Java.type('java.net.http.HttpClient');
    var HttpRequest  = Java.type('java.net.http.HttpRequest');
    var BodyHandlers = Java.type('java.net.http.HttpResponse$BodyHandlers');
    var URI          = Java.type('java.net.URI');
    var URLEncoder   = Java.type('java.net.URLEncoder');

    var repo = execution.getVariable('githubRepo');
    if (!repo) {
      repo = 'hrdtogo/hrdtogo-software';
    }
    var stichwort = (anliegenart === 'datenfehler') ? 'Datenfehler' : 'Technisches Problem';
    var query = URLEncoder.encode('repo:' + repo + ' ' + stichwort + ' is:issue', 'UTF-8');

    var client = HttpClient.newHttpClient();
    var request = HttpRequest.newBuilder()
      .uri(URI.create('https://api.github.com/search/issues?q=' + query))
      .header('Accept', 'application/vnd.github+json')
      .GET()
      .build();
    var response = client.send(request, BodyHandlers.ofString());
    if (response.statusCode() == 200) {
      var match = response.body().match(/"total_count":\s*(\d+)/);
      if (match) {
        anzahl = parseInt(match[1]);
      }
      url = 'https://github.com/' + repo + '/issues?q=' + query;
    }
  } catch (e) {
    anzahl = 0;
    url = '';
  }
}

execution.setVariable('bekannteFehlerAnzahl', anzahl);
execution.setVariable('bekannteFehlerUrl', url);</camunda:script></camunda:executionListener></bpmn:extensionElements><bpmn:incoming>Flow_1vziiau</bpmn:incoming>
      <bpmn:outgoing>Flow_0b1g4ca</bpmn:outgoing>
    </bpmn:userTask>
