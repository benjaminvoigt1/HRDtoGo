    <bpmn:userTask id="Activity_1d2p67u" name="Fehler analysieren" camunda:candidateGroups="data-analyst">
      <bpmn:documentation>Der Data Analyst öffnet den betroffenen Report, prüft die Datengrundlage, identifiziert die Fehlerursache und legt eine Korrekturmaßnahme fest. Bereits bekannte, vergleichbare Fehler aus der GitHub-Issue-Suche (siehe 'Anfrage klassifizieren') werden hier angezeigt.</bpmn:documentation><bpmn:extensionElements><camunda:formData><camunda:formField id="betroffenerReport" label="Betroffener Report" type="string"/><camunda:formField id="fehlerursache" label="Fehlerursache" type="string"/><camunda:formField id="korrekturmassnahme" label="Korrekturmaßnahme" type="string"/><camunda:formField id="bekannteFehlerAnzahl" label="Anzahl bekannter, ähnlicher Fehler (GitHub)" type="long"/><camunda:formField id="bekannteFehlerUrl" label="Link zu bekannten Fehlern (GitHub)" type="string"/><camunda:formField id="ergebnis" label="Bearbeitungsergebnis (für Wissensdatenbank)" type="string"/><camunda:formField id="eskalationErforderlich" label="Eskalation an Teamleitung notwendig?" type="boolean"/></camunda:formData></bpmn:extensionElements><bpmn:incoming>Flow_15uy4kn</bpmn:incoming>
      <bpmn:outgoing>Flow_1rznszs</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_10pw1nx" name="Problem bearbeiten" camunda:candidateGroups="data-analyst">
