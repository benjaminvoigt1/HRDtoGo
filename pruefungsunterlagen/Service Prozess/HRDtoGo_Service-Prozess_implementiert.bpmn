    <bpmn:scriptTask id="Activity_0dya2fw" name="Ticket schließen" scriptFormat="javascript">
      <bpmn:documentation>JavaScript-Task: Wird ausgelöst, wenn 72h nach 'Antwort gesendet' keine Rückfrage des Kunden eingegangen ist (Timer 'Zeit abgelaufen'). Sendet per REST-Aufruf eine Benachrichtigung an den Team-Kanal (Slack Incoming-Webhook, Prozessvariable 'slackWebhookUrl'; ohne Konfiguration Fallback auf den lokalen Mock-Service) und schließt das Ticket.</bpmn:documentation><bpmn:incoming>Flow_11jm9ls</bpmn:incoming>
      <bpmn:outgoing>Flow_0mik4qw</bpmn:outgoing>
    <bpmn:script>// JavaScript-Task: Team per REST/Slack-Webhook ueber automatischen Ticket-Abschluss informieren.
var HttpClient    = Java.type('java.net.http.HttpClient');
var HttpRequest   = Java.type('java.net.http.HttpRequest');
var BodyPublishers = Java.type('java.net.http.HttpRequest$BodyPublishers');
var BodyHandlers  = Java.type('java.net.http.HttpResponse$BodyHandlers');
var URI           = Java.type('java.net.URI');

function val(name) {
  var v = execution.getVariable(name);
  return v === null || v === undefined ? '' : String(v).replace(/"/g, '\\"');
}

var webhookUrl = execution.getVariable('slackWebhookUrl');
var isSlack = webhookUrl &amp;&amp; webhookUrl.indexOf('hooks.slack.com') &gt;= 0;
if (!webhookUrl) {
  webhookUrl = 'http://localhost:8089/api/notifications/ticket-closed';
}

var nachricht = 'Ticket fuer Kunde ' + val('kundennummer')
  + ' (Anliegen: ' + val('anliegenart') + ') wurde automatisch geschlossen, '
  + 'da innerhalb von 72h keine Rueckfrage des Kunden eingegangen ist.';

var payload = isSlack
  ? '{"text":"' + nachricht.replace(/"/g, '\\"') + '"}'
  : '{"kundenId":"' + val('kundennummer') + '","grund":"timeout","nachricht":"' + nachricht.replace(/"/g, '\\"') + '"}';

try {
  var client = HttpClient.newHttpClient();
  var request = HttpRequest.newBuilder()
    .uri(URI.create(webhookUrl))
    .header('Content-Type', 'application/json')
    .POST(BodyPublishers.ofString(payload))
    .build();
  var response = client.send(request, BodyHandlers.ofString());
  execution.setVariable('ticketClosedNotificationStatus', response.statusCode());
} catch (e) {
  execution.setVariable('ticketClosedNotificationStatus', -1);
  execution.setVariable('ticketClosedNotificationError', e.toString());
}

execution.setVariable('ticketStatus', 'geschlossen_zeitueberschreitung');</bpmn:script></bpmn:scriptTask>
    <bpmn:userTask id="Activity_09vqdij" name="Anfrage bearbeiten" camunda:candidateGroups="service-mitarbeiter">
      <bpmn:documentation>Der Kunde hat eine Rückfrage zur gesendeten Antwort gestellt. Der Service-Mitarbeiter prüft die Rückfrage und ergänzt die Antwort, bevor diese erneut an den Kunden gesendet wird.</bpmn:documentation><bpmn:extensionElements><camunda:formData><camunda:formField id="rueckfrageText" label="Rückfrage des Kunden" type="string"/><camunda:formField id="antworttext" label="Ergänzte Antwort" type="string"/><camunda:formField id="ergebnis" label="Bearbeitungsergebnis (für Wissensdatenbank)" type="string"/></camunda:formData></bpmn:extensionElements><bpmn:incoming>Flow_0yoj6xb</bpmn:incoming>
      <bpmn:outgoing>Flow_18kd3uw</bpmn:outgoing>
    </bpmn:userTask>
