    <bpmn:userTask id="Activity_0d43xwj" name="Anfrage prüfen" camunda:candidateGroups="service-mitarbeiter">
      <bpmn:documentation>Der Service-Mitarbeiter prüft die eingegangene Anfrage auf Vollständigkeit der Kunden- und Kontaktdaten sowie der Problembeschreibung. Sind Angaben unvollständig, fordert der Workflow automatisch fehlende Informationen beim Kunden an.</bpmn:documentation><bpmn:extensionElements><camunda:formData><camunda:formField id="kundennummer" label="Kundennummer" type="string"/><camunda:formField id="ansprechpartner" label="Ansprechpartner" type="string"/><camunda:formField id="email" label="E-Mail-Adresse" type="string"/><camunda:formField id="beschreibung" label="Beschreibung des Anliegens" type="string"/><camunda:formField id="betroffenerReport" label="Betroffener Report" type="string"/><camunda:formField id="angabenVollstaendig" label="Angaben vollständig?" type="boolean"/></camunda:formData></bpmn:extensionElements><bpmn:incoming>Flow_0mmyyje</bpmn:incoming>
      <bpmn:outgoing>Flow_1uqu7my</bpmn:outgoing>
    </bpmn:userTask>
