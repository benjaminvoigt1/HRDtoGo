    <bpmn:scriptTask id="Activity_1cki0bd" name="Lösung protokollieren" scriptFormat="javascript">
      <bpmn:documentation>RPA-Bot (JavaScript-Task): Protokolliert das Bearbeitungsergebnis per REST-Aufruf (POST /api/knowledge-base) im Excel-Export / der Wissensdatenbank des Mock-REST-Service.</bpmn:documentation><bpmn:incoming>Flow_01fau5z</bpmn:incoming>
      <bpmn:outgoing>Flow_1fn4stn</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0teknyy">
        <bpmn:targetRef>DataStoreReference_0e4exct</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    <bpmn:script>// RPA-Bot: Bearbeitungsergebnis per REST in der Wissensdatenbank (Excel-Export) protokollieren.
var HttpClient    = Java.type('java.net.http.HttpClient');
var HttpRequest   = Java.type('java.net.http.HttpRequest');
var BodyPublishers = Java.type('java.net.http.HttpRequest$BodyPublishers');
var BodyHandlers  = Java.type('java.net.http.HttpResponse$BodyHandlers');
var URI           = Java.type('java.net.URI');

function val(name) {
  var v = execution.getVariable(name);
  return v === null || v === undefined ? '' : String(v).replace(/"/g, '\\"');
}

var payload = '{'
  + '"kundenId":"' + val('kundennummer') + '",'
  + '"betreff":"' + val('anliegenart') + '",'
  + '"loesung":"' + val('ergebnis') + '"'
  + '}';

var knowledgeBaseUrl = execution.getVariable('knowledgeBaseUrl');
if (!knowledgeBaseUrl) {
  knowledgeBaseUrl = 'http://localhost:8089/api/knowledge-base';
}

try {
  var client = HttpClient.newHttpClient();
  var request = HttpRequest.newBuilder()
    .uri(URI.create(knowledgeBaseUrl))
    .header('Content-Type', 'application/json')
    .POST(BodyPublishers.ofString(payload))
    .build();
  var response = client.send(request, BodyHandlers.ofString());
  execution.setVariable('knowledgeBaseStatus', response.statusCode());
} catch (e) {
  execution.setVariable('knowledgeBaseStatus', -1);
  execution.setVariable('knowledgeBaseError', e.toString());
}</bpmn:script></bpmn:scriptTask>
