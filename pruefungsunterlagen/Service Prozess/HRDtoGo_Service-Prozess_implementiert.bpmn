    <bpmn:startEvent id="Event_175x4em" name="Anfrage erhalten">
      <bpmn:documentation>Startereignis: Der Kunde übermittelt eine Supportanfrage über das digitale Serviceformular. Erfasst werden Kundennummer, Ansprechpartner, Kontaktdaten, Anliegen, Priorität und der betroffene Report.</bpmn:documentation><bpmn:extensionElements><camunda:formData><camunda:formField id="kundennummer" label="Kundennummer" type="string"/><camunda:formField id="ansprechpartner" label="Ansprechpartner" type="string"/><camunda:formField id="email" label="E-Mail-Adresse" type="string"/><camunda:formField id="betroffenerReport" label="Betroffener Report" type="string"/><camunda:formField id="beschreibung" label="Beschreibung des Anliegens" type="string"/><camunda:formField id="anliegenartKunde" label="Anliegenart (Einschätzung Kunde)" type="enum"><camunda:value id="fachliche_rueckfrage" name="Fachliche Rückfrage"/><camunda:value id="datenfehler" name="Datenfehler"/><camunda:value id="technisches_problem" name="Technisches Problem"/><camunda:value id="aenderungswunsch" name="Änderungswunsch"/></camunda:formField><camunda:formField id="prioritaet" label="Priorität" type="enum"><camunda:value id="niedrig" name="niedrig"/><camunda:value id="mittel" name="mittel"/><camunda:value id="hoch" name="hoch"/><camunda:value id="kritisch" name="kritisch"/></camunda:formField></camunda:formData></bpmn:extensionElements><bpmn:outgoing>Flow_0psz38i</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0o69yua" messageRef="Message_Anfrage"/>
    </bpmn:startEvent>
